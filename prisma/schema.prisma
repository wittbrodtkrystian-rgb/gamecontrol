generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPPORT
  CUSTOMER
}
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROVISIONING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
enum PaymentProvider {
  DEMO
  STRIPE
}
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}
enum ServerStatus {
  PENDING
  INSTALLING
  OFFLINE
  STARTING
  RUNNING
  STOPPING
  SUSPENDED
  ERROR
}
enum JobStatus {
  QUEUED
  RUNNING
  WAITING_RESOURCES
  SUCCEEDED
  FAILED
}
enum BackupStatus {
  CREATING
  READY
  FAILED
}
enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(CUSTOMER)
  locale        String   @default("pl")
  disabledAt    DateTime?
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  orders        Order[]
  servers       Server[]
  subscriptions Subscription[]
  tickets       SupportTicket[]
  notifications Notification[]
  auditLogs     AuditLog[]
  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Uczciwa lista możliwości silnika, np. {"plugins":true,"workshop":false}
  features    Json     @default("{}")
  plans       HostingPlan[]
}

model HostingPlan {
  id             String   @id @default(cuid())
  gameId         String
  game           Game     @relation(fields: [gameId], references: [id])
  slug           String   @unique
  name           String
  variant        String?
  priceMonthly   Int      // grosze (PLN)
  ramMb          Int
  cpuPercent     Int
  diskMb         Int
  slots          Int
  available      Boolean  @default(true)
  sortOrder      Int      @default(0)
  pterodactylEggId Int?
  pterodactylNestId Int?
  dockerImage    String?
  orderItems     OrderItem[]
  servers        Server[]
  subscriptions  Subscription[]
  @@index([gameId, available])
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING_PAYMENT)
  totalAmount    Int
  currency       String      @default("PLN")
  idempotencyKey String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  payments       Payment[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planId      String
  plan        HostingPlan @relation(fields: [planId], references: [id])
  planName    String
  serverName  String
  unitPrice   Int
  quantity    Int     @default(1)
  config      Json    @default("{}")
  server      Server?
  subscription Subscription?
  job         ProvisioningJob?
  @@index([orderId])
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  provider        PaymentProvider
  status          PaymentStatus   @default(PENDING)
  amount          Int
  currency        String          @default("PLN")
  providerRef     String?         @unique
  providerEventId String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@index([orderId])
  @@index([status, createdAt])
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  planId           String
  plan             HostingPlan        @relation(fields: [planId], references: [id])
  orderItemId      String             @unique
  orderItem        OrderItem          @relation(fields: [orderItemId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean           @default(false)
  expiryNotifiedAt DateTime?
  createdAt        DateTime           @default(now())
  server           Server?
  @@index([userId])
  @@index([status, currentPeriodEnd])
}

model Node {
  id          String   @id @default(cuid())
  name        String   @unique
  fqdn        String
  location    String
  ramTotalMb  Int
  diskTotalMb Int
  cpuTotal    Int      // 100 = 1 rdzeń
  enabled     Boolean  @default(true)
  maintenance Boolean  @default(false)
  isDemo      Boolean  @default(false)
  pterodactylNodeId Int? @unique
  createdAt   DateTime @default(now())
  servers     Server[]
  allocations Allocation[]
}

model Allocation {
  id       String  @id @default(cuid())
  nodeId   String
  node     Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  ip       String
  port     Int
  serverId String? @unique
  server   Server? @relation("PrimaryAlloc", fields: [serverId], references: [id])
  // Dodatkowa alokacja serwera (np. port txAdmin dla FiveM). Nie liczy się jako wolna dla innych serwerów.
  extraForServerId String?
  extraServer      Server? @relation("ExtraAlloc", fields: [extraForServerId], references: [id])
  pterodactylId Int?
  @@unique([nodeId, ip, port])
  @@index([nodeId, serverId])
  @@index([extraForServerId])
}

model Server {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  planId        String
  plan          HostingPlan  @relation(fields: [planId], references: [id])
  orderItemId   String       @unique
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id])
  subscriptionId String?     @unique
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
  nodeId        String?
  node          Node?        @relation(fields: [nodeId], references: [id])
  name          String
  status        ServerStatus @default(PENDING)
  externalId    String?      // id w Pterodactyl (Application API)
  externalUuid  String?
  ramMb         Int
  cpuPercent    Int
  diskMb        Int
  slots         Int
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  allocation    Allocation?  @relation("PrimaryAlloc")
  extraAllocations Allocation[] @relation("ExtraAlloc")
  metrics       ServerMetric[]
  backups       Backup[]
  @@index([userId])
  @@index([nodeId])
  @@index([status])
}

model ServerMetric {
  id       BigInt   @id @default(autoincrement())
  serverId String
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  ts       DateTime @default(now())
  cpu      Float
  ramMb    Int
  diskMb   Int
  netInKb  Int
  netOutKb Int
  players  Int      @default(0)
  @@index([serverId, ts])
}

model Backup {
  id        String       @id @default(cuid())
  serverId  String
  server    Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name      String
  sizeMb    Int          @default(0)
  status    BackupStatus @default(CREATING)
  externalId String?     // uuid kopii w Pterodactylu (brak dla serwerów DEMO)
  locked    Boolean      @default(false)
  createdAt DateTime     @default(now())
  @@index([serverId, createdAt])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  body      String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  @@index([userId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ProvisioningJob {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([status, runAfter])
}
