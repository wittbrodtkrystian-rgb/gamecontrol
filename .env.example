# Skopiuj do .env i uzupełnij. NIGDY nie commituj .env.
DATABASE_URL="postgresql://gamecontrol:gamecontrol@localhost:5432/gamecontrol?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"

# DEMO = symulowany provisioning i płatności (bez prawdziwych pieniędzy i serwerów)
DEMO_MODE="true"
# Sekret do wywołań /api/internal/run-jobs (cron / worker). Min. 24 znaki.
CRON_SECRET="change-me-to-a-long-random-string"

# Etap 2 — Pterodactyl (tylko po stronie serwera!)
PTERODACTYL_URL=""
PTERODACTYL_APP_API_KEY=""
# Klucz Client API konta admina (sterowanie zasilaniem, stan serwerów)
PTERODACTYL_CLIENT_API_KEY=""
# Pula CPU węzła w % przy synchronizacji (100 = 1 wątek, np. 1200 dla procesora 6c/12t). Domyślnie 400.
NODE_CPU_PERCENT=""

# Etap 3 — Stripe (puste = płatności prawdziwe wyłączone)
STRIPE_SECRET_KEY=""          # sk_test_... (tryb testowy Stripe — bez prawdziwych pieniędzy)
STRIPE_WEBHOOK_SECRET=""

# Seed: hasła kont startowych (jeśli puste, zostaną wygenerowane i wypisane w konsoli)
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""

# Opcjonalnie: ID jajek Minecrafta w Twoim panelu (silnik=ID), np. SEED_MC_EGGS="paper=5,vanilla=1,purpur=15,fabric=16"
SEED_MC_EGGS=""
